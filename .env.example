# ==========================================
# AGRI-TRUST PLATFORM ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION (Spring Boot)
# ------------------------------------------
# Server Port
PORT=8080

# Database Connection (MongoDB Atlas URI or Local MongoDB)
# Example Local: mongodb://localhost:27017/agritrust
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/agritrust?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/agritrust

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment-min-32-bytes
JWT_EXPIRATION_MS=86400000

# Public Trace Portal Base URL (Used for QR Code generation)
PUBLIC_TRACE_BASE_URL=http://localhost:5173/trace

# Allowed CORS Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Dev Admin Bootstrap Credentials (Auto-created on first startup if missing)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@agritrust.com
BOOTSTRAP_ADMIN_PASSWORD=password
BOOTSTRAP_ADMIN_FULL_NAME=System Admin

# ------------------------------------------
# FRONTEND CONFIGURATION (Vite React)
# ------------------------------------------
# API Base URL pointing to Spring Boot Backend
VITE_API_BASE_URL=http://localhost:8080
